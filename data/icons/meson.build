  join_paths('scalable', 'apps', 'com.chipichapa.Dokument.svg'),
  rename: '@0@.svg'.format(app_id),
  install_dir: join_paths(pps_datadir, 'icons', 'hicolor', 'scalable', 'apps'),
)

<component type="desktop-application">
  <id>@APP_ID@</id>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <metadata_license>GPL-2.0+ or GFDL-1.3-only</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <name>Dokument</name>
  <summary>Read documents</summary>
  <description>
    <p>A document viewer for the GNOME desktop. You can view, search or annotate documents in many different formats.</p>
    <p>Dokument is a fork of Papers with quality-of-life improvements, tabs, and document scanning.</p>
    <p>Dokument supports documents in: PDF, DjVu, TIFF, and Comic Books archives (CBR, CBT, CBZ, CB7).</p>
  </description>

  <!-- These allow us to be found in GNOME Software, as it ignores the description for searching: -->
  <keywords>
    <keyword>Document Viewer</keyword>
    <keyword>Papers</keyword>
    <keyword>tabs</keyword>
    <keyword>scanning</keyword>
    <keyword>PDF</keyword>
    <keyword>comics</keyword>
    <keyword>DjVu</keyword>
    <keyword>TIFF</keyword>
    <keyword>reader</keyword>
    <keyword>editor</keyword>
    <keyword>editing</keyword>
    <keyword>forms</keyword>
    <keyword>annotate</keyword>
    <keyword>annotations</keyword>
    <keyword>annotating</keyword>
    <keyword>digital signing</keyword>
    <keyword>digital signatures</keyword>
    <keyword>handwriting</keyword>
    <keyword>handwritten</keyword>
    <keyword>ink</keyword>
    <keyword>freehand</keyword>
    <keyword>drawing</keyword>
    <keyword>calligraphy</keyword>
    <keyword>notes</keyword>
    <keyword>highlighting</keyword>
    <keyword>underline</keyword>
    <keyword>underlining</keyword>
    <keyword>strikethrough</keyword>
    <keyword>printing</keyword>
    <keyword>night mode</keyword>
    <keyword>dark mode</keyword>
    <keyword>presentation mode</keyword>
    <keyword>presenter mode</keyword>
    <keyword>slideshows</keyword>
    <keyword>bookmarks</keyword>
  </keywords>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Chipi-Chapa-Corp/papers/main/data/screenshots/papers-1.png</image>
      <caption>A clear, simple, and modern UI</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Chipi-Chapa-Corp/papers/main/data/screenshots/papers-2.png</image>
      <caption>A mobile-friendly UI</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Chipi-Chapa-Corp/papers/main/data/screenshots/papers-3.png</image>
      <caption>A modern and colorful annotation list</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Chipi-Chapa-Corp/papers/main/data/screenshots/papers-4.png</image>
      <caption>Big thumbnails in the sidebar</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Chipi-Chapa-Corp/papers/main/data/screenshots/papers-5.png</image>
      <caption>All search actions are contained in the sidebar</caption>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#f66151</color>
    <color type="primary" scheme_preference="dark">#a51d2d</color>
  </branding>
  <url type="homepage">https://github.com/Chipi-Chapa-Corp/papers</url>
  <url type="bugtracker">https://github.com/Chipi-Chapa-Corp/papers/issues</url>
  <url type="contribute">https://github.com/Chipi-Chapa-Corp/papers/blob/main/CONTRIBUTING.md</url>
  <url type="vcs-browser">https://github.com/Chipi-Chapa-Corp/papers</url>
  <developer id="com.chipichapa">
    <name>Chipi-Chapa-Corp</name>
  </developer>
  <translation type="gettext">papers</translation>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.1.0" type="stable" date="2026-11-17">
      <description>
        <p>The first release of Dokument, a fork of Papers.</p>
        <ul>
          <li>Open documents in tabs and resize the sidebar.</li>
          <li>Scan documents with SANE, including network scanners and feeders.</li>
          <li>Rotate, crop, reorder, annotate, and save scanned pages as PDF.</li>
          <li>Use Dokument's own application icon and stable Flatpak package.</li>
        </ul>
      </description>
    </release>
  </releases>
</component>

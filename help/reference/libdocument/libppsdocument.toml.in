[library]
version = "@version@"
browse_url = "https://github.com/Chipi-Chapa-Corp/papers/"
repository_url = "https://github.com/Chipi-Chapa-Corp/papers.git"
website_url = "https://github.com/Chipi-Chapa-Corp/papers"
authors = "The GNOME Project"
license = "GPL-2-or-later"
description = "Dokument is a document viewer for multiple document formats."
dependencies = [ "GObject-2.0" ]
devhelp = true
search_index = true

  [dependencies."GObject-2.0"]
  name = "GObject"
  description = "The base type system library"
  docs_url = "https://docs.gtk.org/gobject/"

[theme]
name = "basic"
show_index_summary = true
show_class_hierarchy = true

[source-location]
base_url = "https://github.com/Chipi-Chapa-Corp/papers/blob/main/"

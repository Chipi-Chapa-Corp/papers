<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-2.0-or-later -->
<node>
  <!-- Private peer interface, shared by one document and its worker. -->
  <interface name="org.gnome.Papers.Document">
    <method name="Create">
      <arg name="mime_type" type="s" direction="in"/>
      <arg name="interfaces" type="as" direction="out"/>
    </method>
    <method name="Load">
      <arg name="uri" type="s" direction="in"/>
      <arg name="password" type="s" direction="in"/>
      <arg name="n_pages" type="i" direction="out"/>
    </method>
    <method name="LoadFd">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg name="fd" type="h" direction="in"/>
      <arg name="password" type="s" direction="in"/>
      <arg name="n_pages" type="i" direction="out"/>
    </method>
    <method name="GetPageInfo">
      <arg name="page" type="i" direction="in"/>
      <arg name="width" type="d" direction="out"/>
      <arg name="height" type="d" direction="out"/>
      <arg name="label" type="s" direction="out"/>
    </method>
    <method name="GetInfo">
      <arg name="info" type="a{sv}" direction="out"/>
      <arg name="pages" type="a(dds)" direction="out"/>
      <arg name="backend_name" type="s" direction="out"/>
      <arg name="backend_version" type="s" direction="out"/>
      <arg name="has_security" type="b" direction="out"/>
    </method>
    <method name="Save">
      <arg name="uri" type="s" direction="in"/>
      <arg name="document_state" type="u" direction="out"/>
    </method>
    <method name="GetOutlines">
      <arg name="present" type="b" direction="out"/>
      <arg name="rows" type="a(iba{sv})" direction="out"/>
    </method>
    <method name="GetLinks">
      <arg name="page" type="i" direction="in"/>
      <arg name="present" type="b" direction="out"/>
      <arg name="mappings" type="a((dddd)a{sv})" direction="out"/>
    </method>
    <method name="FindLinkDest">
      <arg name="name" type="s" direction="in"/>
      <arg name="destination" type="a{sv}" direction="out"/>
    </method>
    <method name="FindLinkPage">
      <arg name="name" type="s" direction="in"/>
      <arg name="page" type="i" direction="out"/>
    </method>
    <method name="GetLayers">
      <arg name="present" type="b" direction="out"/>
      <arg name="rows" type="a(iba{sv})" direction="out"/>
    </method>
    <method name="SetLayerVisibility">
      <arg name="layer" type="t" direction="in"/>
      <arg name="visible" type="b" direction="in"/>
    </method>
    <method name="GetLayerVisibility">
      <arg name="layer" type="t" direction="in"/>
      <arg name="visible" type="b" direction="out"/>
    </method>
    <method name="GetText">
      <arg name="page" type="i" direction="in"/>
      <arg name="present" type="b" direction="out"/>
      <arg name="text" type="s" direction="out"/>
    </method>
    <method name="GetTextLayout">
      <arg name="page" type="i" direction="in"/>
      <arg name="present" type="b" direction="out"/>
      <arg name="areas" type="a(dddd)" direction="out"/>
    </method>
    <method name="GetTextMapping">
      <arg name="page" type="i" direction="in"/>
      <arg name="present" type="b" direction="out"/>
      <arg name="region" type="a(iiii)" direction="out"/>
    </method>
    <method name="GetTextAttrs">
      <arg name="page" type="i" direction="in"/>
      <arg name="present" type="b" direction="out"/>
      <arg name="attributes" type="s" direction="out"/>
    </method>
    <method name="GetTextInArea">
      <arg name="page" type="i" direction="in"/>
      <arg name="area" type="(dddd)" direction="in"/>
      <arg name="present" type="b" direction="out"/>
      <arg name="text" type="s" direction="out"/>
    </method>
    <method name="FindText">
      <arg name="page" type="i" direction="in"/>
      <arg name="text" type="s" direction="in"/>
      <arg name="options" type="u" direction="in"/>
      <arg name="matches" type="a(ddddbb)" direction="out"/>
    </method>
    <method name="GetSelectedText">
      <arg name="page" type="i" direction="in"/>
      <arg name="style" type="u" direction="in"/>
      <arg name="points" type="(dddd)" direction="in"/>
      <arg name="present" type="b" direction="out"/>
      <arg name="text" type="s" direction="out"/>
    </method>
    <method name="GetSelectionRegion">
      <arg name="page" type="i" direction="in"/>
      <arg name="rotation" type="i" direction="in"/>
      <arg name="scale" type="d" direction="in"/>
      <arg name="target_width" type="i" direction="in"/>
      <arg name="target_height" type="i" direction="in"/>
      <arg name="style" type="u" direction="in"/>
      <arg name="points" type="(dddd)" direction="in"/>
      <arg name="present" type="b" direction="out"/>
      <arg name="region" type="a(iiii)" direction="out"/>
    </method>
    <method name="RenderSelection">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg name="page" type="i" direction="in"/>
      <arg name="rotation" type="i" direction="in"/>
      <arg name="scale" type="d" direction="in"/>
      <arg name="target_width" type="i" direction="in"/>
      <arg name="target_height" type="i" direction="in"/>
      <arg name="annotations" type="u" direction="in"/>
      <arg name="style" type="u" direction="in"/>
      <arg name="points" type="(dddd)" direction="in"/>
      <arg name="text_color" type="(dddd)" direction="in"/>
      <arg name="base_color" type="(dddd)" direction="in"/>
      <arg name="present" type="b" direction="out"/>
      <arg name="buffer" type="(hiiiidddd)" direction="out"/>
    </method>
    <method name="Render">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg name="page" type="i" direction="in"/>
      <arg name="rotation" type="i" direction="in"/>
      <arg name="scale" type="d" direction="in"/>
      <arg name="target_width" type="i" direction="in"/>
      <arg name="target_height" type="i" direction="in"/>
      <arg name="annotations" type="u" direction="in"/>
      <arg name="thumbnail" type="b" direction="in"/>
      <arg name="buffer" type="(hiiiidddd)" direction="out"/>
    </method>
  </interface>
</node>

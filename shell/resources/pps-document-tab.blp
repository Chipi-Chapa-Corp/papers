using Gtk 4.0;
using Adw 1;
using Gio 2.0;

Gio.Settings settings {
  schema-id: "com.chipichapa.Dokument";
  changed::night-mode => $night_mode_changed() swapped;
}

Gio.Settings default_settings {
  schema-id: "com.chipichapa.Dokument.Default";
}

template $PpsDocumentTab: Adw.Bin {
  child: Adw.ToastOverlay toast_overlay {
    child: Adw.ViewStack stack {
      hhomogeneous: false;
      vhomogeneous: false;

      Adw.ViewStackPage {
        name: "start";

        child: Adw.ToolbarView start_toolbar_view {
          [top]
          Adw.HeaderBar {
            [start]
            Button {
              icon-name: "list-add-symbolic";
              action-name: "win.new-tab";
              tooltip-text: _("New Tab");
            }

            [end]
            MenuButton {
              icon-name: "view-more-symbolic";
              tooltip-text: _("Main Menu");
              menu-model: app_menu;
              primary: true;
            }
          }

          content: Adw.BreakpointBin {
            width-request: 360;
            height-request: 360;

            Adw.Breakpoint {
              condition ("max-width: 550sp")

              setters {
                new_tab_options.orientation: vertical;
                new_tab_options.spacing: 32;
              }
            }

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Box new_tab_options {
                spacing: 48;
                halign: center;
                valign: center;
                margin-top: 32;
                margin-bottom: 32;
                margin-start: 24;
                margin-end: 24;

                Box {
                  orientation: vertical;
                  spacing: 16;
                  width-request: 220;

                  Image {
                    icon-name: "papers-rich-text";
                    pixel-size: 96;

                    styles [
                      "dim-label",
                    ]
                  }

                  Label {
                    label: _("Open a Document");
                    wrap: true;
                    justify: center;

                    styles [
                      "title-1",
                    ]
                  }

                  Label {
                    label: _("Drag and drop documents here");
                    wrap: true;
                    justify: center;
                    height-request: 20;

                    styles [
                      "dim-label",
                    ]
                  }

                  Button open_button {
                    halign: center;
                    width-request: 128;
                    action-name: "win.open";
                    label: _("_Open…");
                    use-underline: true;

                    styles [
                      "suggested-action",
                      "pill",
                    ]
                  }
                }

                Box {
                  orientation: vertical;
                  spacing: 16;
                  width-request: 220;

                  Image {
                    icon-name: "scanner-symbolic";
                    pixel-size: 96;

                    styles [
                      "dim-label",
                    ]
                  }

                  Label {
                    label: _("Scan a Document");
                    wrap: true;
                    justify: center;

                    styles [
                      "title-1",
                    ]
                  }

                  Box {
                    height-request: 20;
                  }

                  Button {
                    halign: center;
                    width-request: 128;
                    label: _("_Scan…");
                    use-underline: true;
                    clicked => $start_scan_clicked() swapped;

                    styles [
                      "suggested-action",
                      "pill",
                    ]
                  }
                }
              };
            };
          };
        };
      }

      Adw.ViewStackPage {
        name: "scan";

        child: Box scan_box {
          orientation: vertical;
        };
      }

      Adw.ViewStackPage {
        name: "error";

        child: Adw.ToolbarView error_toolbar_view {
          [top]
          Adw.HeaderBar {}

          content: Adw.StatusPage error_page {
            icon-name: "dialog-error-symbolic";
            title: _("Unable to Open Document");

            child: Button {
              halign: center;
              action-name: "win.open";
              label: _("_Open Other File…");
              use-underline: true;

              styles [
                "suggested-action",
                "pill",
              ]
            };
          };
        };
      }

      Adw.ViewStackPage {
        name: "password";

        child: $PpsPasswordView password_view {
          unlock => $password_view_unlock() swapped;
          cancelled => $password_view_cancelled() swapped;
        };
      }

      Adw.ViewStackPage {
        name: "loader";

        child: $PpsLoaderView loader_view {
          cancel => $loader_view_cancelled() swapped;
        };
      }

      Adw.ViewStackPage {
        name: "document";

        child: $PpsDocumentView document_view {
          close-finished => $document_view_close_finished() swapped;
          open-copy => $document_view_open_copy() swapped;
        };
      }

      Adw.ViewStackPage {
        name: "presentation";

        child: $PpsViewPresentation presentation {
          finished => $presentation_finished() swapped;
          external-link => $external_link_clicked() swapped;

          ShortcutController {
            Shortcut {
              trigger: "Escape";
              action: "action(win.escape)";
            }
          }
        };
      }
    };
  };
}

Adw.AlertDialog error_alert {
  responses [
    close: _("_Close"),
  ]
}

menu app_menu {
  section {
    item {
      label: _("New _Tab");
      action: "win.new-tab";
    }

    item {
      label: _("New _Window");
      action: "app.new";
    }
  }

  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_Help");
      action: "app.help";
    }

    item {
      label: _("_About Dokument");
      action: "app.about";
    }
  }
}
